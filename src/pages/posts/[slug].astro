---
import Base from '../../layouts/Base.astro';
import Comment from '../../components/Comment.astro';
import ArticleBody from '../../components/article/ArticleBody.astro';
import type { Block } from '../../components/article/blocks/types';
import { getCollection } from 'astro:content';

interface Adjacent {
  slug: string;
  date: string;
  title: string;
}

export async function getStaticPaths() {
  const slugOf = p => String(p.id).split('/').pop().replace(/\.md$/, '');
  const all = await getCollection('posts');
  // pager 按类别隔离：prev/next 只在本 column 内翻（内核日报/周报…一组、内核英语一组），
  // 共用数据源但互不越界（英语文章不会翻到内核日报）
  return all.map(p => {
    const col = p.data.column || 'daily';
    const same = all
      .filter(q => (q.data.column || 'daily') === col)
      .sort((a, b) => a.data.date.localeCompare(b.data.date));
    const i = same.findIndex(q => q.id === p.id);
    return {
      params: { slug: slugOf(p) },
      props: {
        post: p,
        prev: i > 0
          ? { slug: slugOf(same[i - 1]), date: same[i - 1].data.date, title: same[i - 1].data.title }
          : null,
        next: i < same.length - 1
          ? { slug: slugOf(same[i + 1]), date: same[i + 1].data.date, title: same[i + 1].data.title }
          : null,
      },
    };
  });
}

const { post, prev, next } = Astro.props;
const displayDate = post.data.date.slice(5);
---
<Base title={`${post.data.title} · Linux 内核玩家`} desc={post.data.desc}>
  <div class="article-bg">
  <main class="container">
    <!-- ① 文章头卡（与主页 hero 同款：全宽渐变带 + term-deco + eyebrow） -->
    <header class="article-hero">
      <a class="back-link" href="/">← 首页</a>
      <span class="term-deco">$ watch -n 10 kernel-patches</span>
      <div class="hero-inner">
        <span class="hero-eyebrow reveal">KERNEL DAILY · {displayDate}</span>
        <h1 class="reveal">{post.data.title}</h1>
        <p class="subtitle reveal">{post.data.desc}</p>
      </div>
    </header>

    <!-- ②-⑨ 卡片式正文（含落款 CTA 卡） -->
    <div class="article-body">
      <ArticleBody blocks={post.data.blocks as Block[]} />
    </div>

    <!-- ⑪ 评论区（紧跟落款 CTA，顺势留言） -->
    <Comment />

    <!-- 标签 + 分享（小卡） -->
    <div class="article-tools reveal">
      <div class="article-tags">
        {post.data.tags.map(t => <span class="tag">{t}</span>)}
      </div>
      <button class="share-btn share-copy">🔗 复制链接</button>
    </div>

    <!-- ⑩ 翻页卡区 -->
    <nav class="article-pager reveal">
      {prev
        ? (
          <a class="pager-prev" href={`/posts/${prev.slug}/`}>
            <span class="dir">← 上一篇 · {prev.date.slice(5)}</span>
            <span class="t">{prev.title}</span>
          </a>
        )
        : <span class="pager-empty" aria-hidden="true" />}
      {next
        ? (
          <a class="pager-next" href={`/posts/${next.slug}/`}>
            <span class="dir">{next.date.slice(5)} · 下一篇 →</span>
            <span class="t">{next.title}</span>
          </a>
        )
        : <span class="pager-empty" aria-hidden="true" />}
    </nav>

  </main>
  </div>
</Base>

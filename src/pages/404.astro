---
import Base from '../layouts/Base.astro';
const title = '页面不存在 · Linux 内核玩家';
---
<Base title={title} desc="你要找的内容不存在或已移动">
  <main class="container">
    <header class="article-hero" style="text-align:center">
      <h1 style="font-size:3.5rem;margin-bottom:1rem;color:var(--text)">404</h1>
      <p class="subtitle" style="color:var(--text-secondary);margin-bottom:1.5rem">
        你要找的页面不存在，或已被移动。
      </p>
      <a href="/" style="display:inline-block;color:var(--brand);font-weight:600">← 回到首页</a>
    </header>
  </main>
</Base>

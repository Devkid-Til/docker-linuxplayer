---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { COLUMNS, ALL_COLUMN, COLUMN_MAP } from '../column';
import fs from 'node:fs';
import path from 'node:path';
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const slugOf = p => String(p.id).split('/').pop().replace(/\.md$/, '');

// 栏目计数（过滤栏 tab 所用）
const columnCounts: Record<string, number> = {};
posts.forEach(p => {
  const c = p.data.column || 'daily';
  columnCounts[c] = (columnCounts[c] || 0) + 1;
});

// 主切换视图：内核内容流（全部栏目，不含英语/手记）与「内核英语」「站长手记」独立视图——平级
const kernelPosts = posts.filter(p => !['english', 'journal'].includes(p.data.column || 'daily'));
const englishPosts = posts.filter(p => p.data.column === 'english');
// 英语视图维度 tab：固定词表（column.ts english.tags，稳定不随文章变动）+ emoji + 文章计数
const ENGLISH_TAG_EMOJI: Record<string, string> = {
  '标题解析': '🔖', '术语卡': '🃏', '地道表达': '💬', '阅读': '📖', '写作': '✍️', '口语': '🎤',
};
const englishCounts = englishPosts.reduce((acc, p) => { p.data.tags.forEach(t => { acc[t] = (acc[t] || 0) + 1; }); return acc; }, {} as Record<string, number>);
const englishFilterTabs = (COLUMN_MAP['english']?.tags ?? []).map(t => ({
  name: t, emoji: ENGLISH_TAG_EMOJI[t] || '', count: englishCounts[t] || 0,
}));
// 站长手记：独立视图（低频不定期），固定词表 + emoji
const journalPosts = posts.filter(p => p.data.column === 'journal');
const JOURNAL_TAG_EMOJI: Record<string, string> = { '笔记': '📓', '感谢': '🙏', '随想': '💭' };
const journalCounts = journalPosts.reduce((acc, p) => { p.data.tags.forEach(t => { acc[t] = (acc[t] || 0) + 1; }); return acc; }, {} as Record<string, number>);
const journalFilterTabs = (COLUMN_MAP['journal']?.tags ?? []).map(t => ({
  name: t, emoji: JOURNAL_TAG_EMOJI[t] || '', count: journalCounts[t] || 0,
}));

// 每栏目独立 tag 栏：只统计该栏目自己的文章 + 该栏目词表内的标签
// （词表由 schema 强制，这里只需按栏目聚合即可）
const columnTags: Record<string, { name: string; count: number }[]> = {};
const columnTagsUseful: Record<string, boolean> = {};
for (const c of COLUMNS) {
  const colPosts = posts.filter(p => (p.data.column || 'daily') === c.value);
  const counts: Record<string, number> = {};
  colPosts.forEach(p => p.data.tags.forEach(t => { counts[t] = (counts[t] || 0) + 1; }));
  const list = Object.entries(counts)
    .map(([name, count]) => ({ name, count }))
    .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
  columnTags[c.value] = list;
  /* 自适应显隐：帖子 <2 / 标签 <2 / 每个标签都是常量（命中数=帖子数）→ 无筛选价值，隐藏 */
  const hasDiscriminator = list.some(t => t.count < colPosts.length);
  columnTagsUseful[c.value] = colPosts.length >= 2 && list.length >= 2 && hasDiscriminator;
}

// 最新一篇的 slug（"今日" 徽标锚定列表最顶一篇，不限栏目——周报/日报都是当日产出；posts 已按日期降序）
const latestSlug = posts.length > 0 ? slugOf(posts[0]) : '';
// 板块活跃度（雷达社区情报）：radar.sh stats 产出的 JSON，构建时读入；缺文件/坏 JSON 静默降级（不编造数据）
// 模拟数据（预览）：真数据（radar.sh stats）就绪前，先用模拟数字展示条形+数字效果。
// 取值按真实热度形态（lkml 广播源最大、net 次之、virtio-dev 极低频最冷），UI 显式标注"模拟预览"。
// 真数据接入后 isMock 自动为 false、标注消失，模拟值不残留。
const MOCK_STATS = { date: '2026-08-08', window: '24h', lists: { lkml: 986, net: 168, media: 121, mm: 94, fs: 82, DRM: 67, arch: 54, block: 46, LSM: 38, PCI: 30, Rust: 21, rt: 12, virtio: 6 } };
let radarStats: { date?: string; window?: string; lists?: Record<string, number> } | null = null;
let isMock = false;
{
  // 注意：不能用 import.meta.url 解析相对路径——Astro build 时（Vite 打包）import.meta.url 指向
  // 编译产物而非源码 src/pages/index.astro，../data/ 会错位导致读不到文件、误回退到模拟数据。
  // 用 process.cwd()（build 时 = 项目根）拼绝对路径，稳定读取。
  const statsPath = path.join(process.cwd(), 'src/data/radar-stats.json');
  if (fs.existsSync(statsPath)) {
    try { radarStats = JSON.parse(fs.readFileSync(statsPath, 'utf8')); } catch { /* 坏 JSON 当无数据 */ }
  }
  if (!radarStats) { radarStats = MOCK_STATS; isMock = true; }
}
// 热度条：按消息量降序 + 最大归一化宽度
const boardHeat: { name: string; count: number }[] = radarStats?.lists
  ? Object.entries(radarStats.lists).map(([name, count]) => ({ name, count })).sort((a, b) => b.count - a.count)
  : [];
const heatMax = boardHeat.length > 0 ? Math.max(...boardHeat.map(h => h.count)) : 1;
// 数据槽位：13 板块固定榜单（与 radar.sh stats 的 SHORT 短名一致）。
// lkml（linux-kernel 全内核广播源）置顶——跨板块补丁都抄送这里，先看全局再看子板块；
// 其余按 radar.sh 源顺序排布。无数据时渲染为"榜单轮廓"占位（板块名 + 空条 + "—"，不编造消息数），
// 数据就绪后替换为真实热度条（届时按真实消息量降序，lkml 通常仍居首）。
const BOARD_SLOTS = ['lkml', 'media', 'DRM', 'mm', 'PCI', 'net', 'fs', 'virtio', 'Rust', 'LSM', 'block', 'arch', 'rt'];
---
<Base title="Linux 内核玩家 · 每日内核雷达">
  <header class="hero">
    <div class="hero-bg"></div>
    <span class="term-deco">$ watch -n 10 kernel-patches</span>
    <div class="container hero-inner">
      <span class="hero-eyebrow reveal">KERNEL DAILY · 每日内核雷达</span>
      <h1 class="reveal">每天 <span>10 分钟</span>，追踪 Linux 内核前沿</h1>
      <p class="subtitle reveal">一份为内核开发者准备的每日简报</p>
      <div class="hero-actions reveal"><a class="btn btn-primary" href="/subscribe/">📡 订阅 RSS</a></div>
    </div>
  </header>

  <section class="features">
    <div class="container">
      <div class="section-header reveal"><h2>模块活跃度</h2><span class="mono">/ radar status</span></div>
      <div class="board-heat reveal">
        <div class="board-heat-head">
          <span class="board-heat-meta">近 {radarStats?.window || '24h'}{radarStats?.date ? ` · ${radarStats.date}` : ''}{isMock ? ' · 模拟预览' : ''}</span>
        </div>
        {boardHeat.length > 0 ? (
          boardHeat.map(h => (
            <div class="heat-item">
              <span class="heat-name">{h.name}</span>
              <span class="heat-bar"><span class="heat-fill" style={`--w:${heatMax > 0 ? Math.round((h.count / heatMax) * 100) : 0}%`}></span></span>
              <span class="heat-count">{h.count}</span>
            </div>
          ))
        ) : (
          /* 数据槽位：13 板块榜单轮廓（板块名可见 + 空条 + "—"，不编造消息数）；
             视觉清晰、可辨识"这里是活跃度排行榜"，数据就绪后替换为真实热度条 */
          <div class="heat-placeholder">
            {BOARD_SLOTS.map(name => (
              <div class="heat-placeholder-row">
                <span class="heat-name">{name}</span>
                <span class="heat-bar"><span class="heat-empty"></span></span>
                <span class="heat-count">—</span>
              </div>
            ))}
            <p class="board-heat-note">📡 数据同步中——内核邮件源就绪后，自动填充各板块近 24h 消息量。</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <main class="container home-main">
    <div class="section-header reveal"><h2>全部栏目</h2><span class="mono">/ columns</span></div>
    <!-- 主切换：全部栏目（内核内容流）| 内核英语（独立视图）——同级 tab -->
    <div class="main-tabs reveal">
      <button class="main-tab active" data-view="kernel">内核内容 <span class="count">{kernelPosts.length}</span></button>
      <button class="main-tab" data-view="english">内核英语 <span class="count">{englishPosts.length}</span></button>
      <button class="main-tab" data-view="journal">站长手记 <span class="count">{journalPosts.length}</span></button>
    </div>

    <!-- 视图①：全部栏目（日报/周报/月报/季报/年报，不含英语） -->
    <div class="main-view" id="view-kernel">
      <div class="column-filter reveal" id="column-filter">
        <button class="filter-column active" data-column="all">{ALL_COLUMN.label} <span class="count">{kernelPosts.length}</span></button>
        {COLUMNS.filter(c => !['english', 'journal'].includes(c.value)).map(c => <button class="filter-column" data-column={c.value}>{c.emoji} {c.label}<span class="count"> {columnCounts[c.value] || 0}</span></button>)}
      </div>
      {COLUMNS.filter(c => !['english', 'journal'].includes(c.value) && columnTagsUseful[c.value]).map(c => (
        <div class="tag-filter reveal hidden" data-column={c.value}>
          <button class="filter-tag active" data-tag="all">全部 <span class="count">{columnCounts[c.value] || 0}</span></button>
          {columnTags[c.value].map(t => <button class="filter-tag" data-tag={t.name}>{t.name}<span class="count"> {t.count}</span></button>)}
        </div>
      ))}
      <div class="post-timeline">
        {kernelPosts.map((p, i) => <PostCard latest={slugOf(p) === latestSlug} column={p.data.column || 'daily'} slug={slugOf(p)} date={p.data.date} title={p.data.title} desc={p.data.desc} tags={p.data.tags} />)}
      </div>
    </div>

    <!-- 视图②：内核英语（学习维度标签过滤 + 英语文章流，独立于全部栏目） -->
    <div class="main-view hidden" id="view-english">
      <div class="column-filter reveal" id="english-filter">
        <button class="filter-tag active" data-tag="all">全部 <span class="count">{englishPosts.length}</span></button>
        {englishFilterTabs.map(t => <button class="filter-tag" data-tag={t.name}>{t.emoji} {t.name}<span class="count"> {t.count}</span></button>)}
      </div>
      <div class="post-timeline">
        {englishPosts.map((p, i) => <PostCard latest={false} column={p.data.column || 'daily'} slug={slugOf(p)} date={p.data.date} title={p.data.title} desc={p.data.desc} tags={p.data.tags} focus={p.data.focus} />)}
      </div>
    </div>

    <!-- 视图③：站长手记（笔记/感谢/随想，独立视图，低频不定期） -->
    <div class="main-view hidden" id="view-journal">
      <div class="column-filter reveal" id="journal-filter">
        <button class="filter-tag active" data-tag="all">全部 <span class="count">{journalPosts.length}</span></button>
        {journalFilterTabs.map(t => <button class="filter-tag" data-tag={t.name}>{t.emoji} {t.name}<span class="count"> {t.count}</span></button>)}
      </div>
      <div class="post-timeline">
        {journalPosts.map((p, i) => <PostCard latest={false} column={p.data.column || 'daily'} slug={slugOf(p)} date={p.data.date} title={p.data.title} desc={p.data.desc} tags={p.data.tags} />)}
      </div>
    </div>

    <div class="about-card reveal">
      <div class="about-avatar">&gt;_<span class="cursor">▋</span></div>
      <div class="about-main">
        <h3>关于 Linux 内核玩家</h3>
        <p>内核玩家的每日手记——把每个补丁讲成"动了哪一层、为什么值得看"。</p>
        <div class="about-coverage">
          <span class="coverage-item">🧠 只看影响架构层的机制级改动</span>
          <span class="coverage-item">🔄 跨域桥接：dma-buf / VMA / Rust 内核化</span>
          <span class="coverage-item">💡 前沿：新驱动框架 / 新硬件 / 安全机制</span>
        </div>
      </div>
    </div>
  </main>
</Base>

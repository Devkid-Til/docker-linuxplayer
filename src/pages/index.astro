---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { COLUMNS, ALL_COLUMN } from '../column';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const slugOf = p => String(p.id).split('/').pop().replace(/\.md$/, '');

// 栏目计数（过滤栏 tab 所用）
const columnCounts: Record<string, number> = {};
posts.forEach(p => {
  const c = p.data.column || 'daily';
  columnCounts[c] = (columnCounts[c] || 0) + 1;
});

// 每栏目独立 tag 栏：只统计该栏目自己的文章 + 该栏目词表内的标签
// （词表由 schema 强制，这里只需按栏目聚合即可）
const columnTags: Record<string, { name: string; count: number }[]> = {};
const columnTagsUseful: Record<string, boolean> = {};
for (const c of COLUMNS) {
  const colPosts = posts.filter(p => (p.data.column || 'daily') === c.value);
  const counts: Record<string, number> = {};
  colPosts.forEach(p => p.data.tags.forEach(t => { counts[t] = (counts[t] || 0) + 1; }));
  const list = Object.entries(counts)
    .map(([name, count]) => ({ name, count }))
    .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
  columnTags[c.value] = list;
  /* 自适应显隐：帖子 <2 / 标签 <2 / 每个标签都是常量（命中数=帖子数）→ 无筛选价值，隐藏 */
  const hasDiscriminator = list.some(t => t.count < colPosts.length);
  columnTagsUseful[c.value] = colPosts.length >= 2 && list.length >= 2 && hasDiscriminator;
}

// 最新一篇日报的 slug（"今日" 徽标锚定此篇）
const dailyPosts = posts.filter(p => (p.data.column || 'daily') === 'daily');
const latestDailySlug = dailyPosts.length > 0 ? slugOf(dailyPosts[0]) : '';
---
<Base title="Linux 内核玩家 · 博客">
  <header class="hero">
    <span class="term-deco">$ watch -n 10 kernel-patches</span>
    <div class="container hero-inner">
      <span class="hero-eyebrow reveal">KERNEL DAILY · 每日内核雷达</span>
      <h1 class="reveal">每天 <span>10 分钟</span>，追踪 Linux 内核前沿</h1>
      <p class="subtitle reveal">一份为内核开发者准备的每日简报</p>
      <div class="hero-actions reveal"><a class="btn btn-primary" href="/subscribe/">📡 订阅 RSS</a></div>
    </div>
  </header>

  <section class="features">
    <div class="container">
      <div class="section-header reveal"><h2>这份日报覆盖什么</h2><span class="mono">/ coverage</span></div>
      <div class="features-grid">
        <div class="feature-card reveal"><span class="feature-icon">🧠</span><h3>内核架构</h3><p>内存管理、进程调度、文件系统、网络栈。不看驱动小修，只看影响架构层的机制级改动。</p></div>
        <div class="feature-card reveal"><span class="feature-icon">🔄</span><h3>跨域机制</h3><p>dma-buf、VMA、P2PDMA、Rust 内核化。子系统之间的桥接层——改动一处，影响全栈。</p></div>
        <div class="feature-card reveal"><span class="feature-icon">💡</span><h3>前沿动态</h3><p>新驱动框架、新硬件支持、virtio 虚拟化、安全机制。每天追踪 linux-media / dri-devel / linux-mm，一条链讲透。</p></div>
      </div>
    </div>
  </section>

  <main class="container">
    <div class="section-header reveal"><h2>全部栏目</h2><span class="mono">/ columns</span></div>
    <div class="column-filter reveal" id="column-filter">
      <button class="filter-column active" data-column="all">{ALL_COLUMN.label} <span class="count">{posts.length}</span></button>
      {COLUMNS.map(c => <button class="filter-column" data-column={c.value}>{c.emoji} {c.label}<span class="count"> {columnCounts[c.value] || 0}</span></button>)}
    </div>
    {COLUMNS.filter(c => columnTagsUseful[c.value]).map(c => (
      <div class="tag-filter reveal hidden" data-column={c.value}>
        <button class="filter-tag active" data-tag="all">全部 <span class="count">{columnCounts[c.value] || 0}</span></button>
        {columnTags[c.value].map(t => <button class="filter-tag" data-tag={t.name}>{t.name}<span class="count"> {t.count}</span></button>)}
      </div>
    ))}
    <div class="post-timeline">
      {posts.map((p, i) => <PostCard latest={slugOf(p) === latestDailySlug} column={p.data.column || 'daily'} slug={slugOf(p)} date={p.data.date} title={p.data.title} desc={p.data.desc} tags={p.data.tags} />)}
    </div>
    <div class="about-card reveal">
      <div class="about-avatar">&gt;_<span class="cursor">▋</span></div>
      <div><h3>关于 Linux 内核玩家</h3><p>内核玩家的每日手记——把每个补丁讲成"动了哪一层、为什么值得看"。</p></div>
    </div>
  </main>
</Base>

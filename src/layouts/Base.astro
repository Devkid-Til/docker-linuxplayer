---
// 公共布局：全局样式 + 导航 + 页脚 + 粒子/光晕/暗色
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
// 品牌配色单一数据源：--brand 系列 token 从这里注入，改色只改 src/brand.json
import brand from '../brand.json';

interface Props {
  title: string;
  desc?: string;
}
const { title, desc = '每天 10 分钟，追踪 Linux 内核前沿动态' } = Astro.props;
// 读当前激活主题（brand.json current 字段）。主题含 variants.light/dark 时按 html.dark 选套；
// 无 variants 的主题（兼容）单套注入 :root。
const theme = brand.themes[brand.current];
const hasVar = !!theme.variants;
const lightCfg = hasVar ? theme.variants.light : theme;
const darkCfg = hasVar ? theme.variants.dark : null;

function buildTokens(cfg) {
  const b = cfg.channels.blog;
  const fx = cfg.effects;
  const glow = `rgba(${parseInt(b.primary.slice(1, 3), 16)},${parseInt(b.primary.slice(3, 5), 16)},${parseInt(b.primary.slice(5, 7), 16)},0.18)`;
  // 特效按 enabled 注入（disabled 时给透明，CSS 端无副作用）；hero 背景图（effects.heroImage，无则 none）
  const grid = fx.grid.enabled ? fx.grid.color : 'transparent';
  const gridOp = fx.grid.enabled ? fx.grid.opacity : 0;
  const cardGlow = fx.cardNeon.enabled ? fx.cardNeon.glowColor : 'transparent';
  const cardBorder = fx.cardNeon.enabled ? fx.cardNeon.borderColor : 'var(--border)';
  const heroImg = fx.heroImage ? `url('${fx.heroImage}')` : 'none';
  // hero 遮蔽率（overlay）：顶部/中部/底部三档，light 调低让图透出、dark 适中做品牌过渡（UI 默认值兜底）
  const ov = fx.overlay || { top: 0.5, mid: 0.42, bottom: 0.55 };
  // hero 文字色：有 heroImage（深色背景图）时用浅色保证可读；无图用主题文字色
  const heroText = fx.heroImage ? '#FFFFFF' : b.text;
  const heroTextSec = fx.heroImage ? 'rgba(255,255,255,.82)' : b.textSecondary;
  const heroAccent = fx.heroImage ? '#C4B5FD' : b.primary;
  const heroEyebrowBg = fx.heroImage ? 'rgba(255,255,255,.14)' : b.primaryBg;
  return `--brand:${b.primary};--brand-light:${b.primaryLight};--brand-dark:${b.primaryDark};--brand-bg:${b.primaryBg};--brand-border:${b.primaryBorder};--brand-glow:${glow};--bg:${b.bg};--bg-alt:${b.bgAlt};--card:${b.bg};--border:${b.border};--border-light:${b.border};--text:${b.text};--text-secondary:${b.textSecondary};--text-tertiary:${b.textTertiary};--fx-glow:${fx.heroGlow.color};--fx-grid:${grid};--fx-grid-opacity:${gridOp};--fx-particle:${fx.particles.color};--fx-card-glow:${cardGlow};--fx-card-border:${cardBorder};--hero-image:${heroImg};--hero-ov-top:${ov.top};--hero-ov-mid:${ov.mid};--hero-ov-bottom:${ov.bottom};--hero-text:${heroText};--hero-text-secondary:${heroTextSec};--hero-accent:${heroAccent};--hero-eyebrow-bg:${heroEyebrowBg}`;
}

const lightTokens = buildTokens(lightCfg);
const darkTokens = darkCfg ? buildTokens(darkCfg) : '';
// 品牌 token 以字符串注入（is:global style 的 {expr} 插值不生效，用 is:inline + set:html）
const brandCss = `:root{${lightTokens}}${darkTokens ? ` html.dark{${darkTokens}}` : ''}`;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={desc} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <title>{title}</title>
  <script is:inline>
    (function(){var t=localStorage.getItem('kernel-blog-theme');if(t==='dark'||(t===null&&matchMedia('(prefers-color-scheme:dark)').matches))document.documentElement.classList.add('dark');})()
  </script>
  <style is:inline set:html={brandCss}></style>
</head>
<body>
  <div class="progress-bar"></div>
  <canvas id="particles-canvas"></canvas>
  <div class="cursor-glow"></div>

  <Nav />

  <slot />

  <Footer />

  <button class="to-top" id="to-top" aria-label="回到顶部">↑</button>

  <script>
    import '../scripts/main.js';
  </script>
</body>
</html>

---
// 公共布局：全局样式 + 导航 + 页脚 + 粒子/光晕/暗色
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
// 品牌配色单一数据源：--brand 系列 token 从这里注入，改色只改 src/brand.json
import brand from '../brand.json';

interface Props {
  title: string;
  desc?: string;
}
const { title, desc = '每天 10 分钟，追踪 Linux 内核前沿动态' } = Astro.props;
const b = brand.channels.blog;
const brandGlow = `rgba(${parseInt(b.primary.slice(1, 3), 16)},${parseInt(b.primary.slice(3, 5), 16)},${parseInt(b.primary.slice(5, 7), 16)},0.18)`;
// 品牌 token 以字符串注入（is:global style 的 {expr} 插值不生效，用 is:inline + set:html）
const brandCss = `:root{--brand:${b.primary};--brand-light:${b.primaryLight};--brand-dark:${b.primaryDark};--brand-bg:${b.primaryBg};--brand-border:${b.primaryBorder};--brand-glow:${brandGlow}}`;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={desc} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <title>{title}</title>
  <script is:inline>
    (function(){var t=localStorage.getItem('kernel-blog-theme');if(t==='dark'||(t===null&&matchMedia('(prefers-color-scheme:dark)').matches))document.documentElement.classList.add('dark');})()
  </script>
  <style is:inline set:html={brandCss}></style>
</head>
<body>
  <div class="progress-bar"></div>
  <canvas id="particles-canvas"></canvas>
  <div class="cursor-glow"></div>

  <Nav />

  <slot />

  <Footer />

  <button class="to-top" id="to-top" aria-label="回到顶部">↑</button>

  <script>
    import '../scripts/main.js';
  </script>
</body>
</html>

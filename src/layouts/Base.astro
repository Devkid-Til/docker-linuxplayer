---
// 公共布局：全局样式 + 导航 + 页脚 + 粒子/光晕/暗色
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AnnouncementDrawer from '../components/AnnouncementDrawer.astro';
import FeedbackFab from '../components/FeedbackFab.astro';
// 品牌配色单一数据源：--brand 系列 token 从这里注入，改色只改 src/brand.json
import brand from '../brand.json';

interface Props {
  title: string;
  desc?: string;
}
const { title, desc = '每天 10 分钟，追踪 Linux 内核前沿动态' } = Astro.props;
// SEO：canonical + OG/Twitter 卡片（分享到微信/社交有预览）。Astro.site 在 build 时取 astro.config 的 site
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321').href;
const ogImage = new URL('/milkyway-hero.jpg', Astro.site ?? 'http://localhost:4321').href;
// 读当前激活主题（brand.json current 字段）。主题含 variants.light/dark 时按 html.dark 选套；
// 无 variants 的主题（兼容）单套注入 :root。
const theme = brand.themes[brand.current];
const hasVar = !!theme.variants;
const lightCfg = hasVar ? theme.variants.light : theme;
const darkCfg = hasVar ? theme.variants.dark : null;

function buildTokens(cfg) {
  const b = cfg.channels.blog;
  const fx = cfg.effects;
  const glow = `rgba(${parseInt(b.primary.slice(1, 3), 16)},${parseInt(b.primary.slice(3, 5), 16)},${parseInt(b.primary.slice(5, 7), 16)},0.18)`;
  // 特效按 enabled 注入（disabled 时给透明，CSS 端无副作用）；hero 背景图（effects.heroImage，无则 none）
  const grid = fx.grid.enabled ? fx.grid.color : 'transparent';
  const gridOp = fx.grid.enabled ? fx.grid.opacity : 0;
  const cardGlow = fx.cardNeon.enabled ? fx.cardNeon.glowColor : 'transparent';
  const cardBorder = fx.cardNeon.enabled ? fx.cardNeon.borderColor : 'var(--border)';
  const heroImg = fx.heroImage ? `url('${fx.heroImage}')` : 'none';
  // 手机版 hero 图（effects.heroImageMobile）：按 DPR3 手机的取景窗口裁剪过，体积约为原图一半。
  // 只在小屏启用——桌面端继续用原图，观感零变化。
  const heroImgMobile = fx.heroImage && fx.heroImageMobile ? fx.heroImageMobile : '';
  // hero 遮蔽率（overlay）：顶部/中部/底部三档，light 调低让图透出、dark 适中做品牌过渡（UI 默认值兜底）
  const ov = fx.overlay || { top: 0.5, mid: 0.42, bottom: 0.55 };
  // hero 文字色：有 heroImage（深色背景图）时用浅色保证可读；无图用主题文字色
  const heroText = fx.heroImage ? '#FFFFFF' : b.text;
  const heroTextSec = fx.heroImage ? 'rgba(255,255,255,.82)' : b.textSecondary;
  // heroAccent 按主题 primaryLight 取色（light 中紫 / dark 淡紫），不再两模式硬编码同一 #C4B5FD
  const heroAccent = fx.heroImage ? b.primaryLight : b.primary;
  const heroEyebrowBg = fx.heroImage ? 'rgba(255,255,255,.14)' : b.primaryBg;
  // 首页 hero 遮蔽渐变（沿用既有 CSS 值：52% 透明→86% bg68%→100% bg 纯色），token 化输出到 --hero-overlay
  const heroOverlay = fx.heroImage ? `linear-gradient(180deg,transparent 52%,color-mix(in srgb,${b.bg} 68%,transparent) 86%,${b.bg} 100%)` : 'none';
  // 文章页全幅星空遮罩：articleOverlay 高不透明度保证正文可读（随主题变体配置，缺省兜底）
  const ao = fx.articleOverlay || { top: 0.85, mid: 0.92, bottom: 0.97 };
  const articleShield = fx.heroImage
    ? `linear-gradient(180deg,color-mix(in srgb,${b.bg} ${Math.round(ao.top * 100)}%,transparent) 0%,color-mix(in srgb,${b.bg} ${Math.round(ao.mid * 100)}%,transparent) 55%,color-mix(in srgb,${b.bg} ${Math.round(ao.bottom * 100)}%,transparent) 100%)`
    : 'none';
  // 手机版 token：单独输出 --hero-image-m，由下方的媒体查询在小屏把 --hero-image 指过去。
  // 这样深浅两套各自带自己的手机图，媒体查询里两条规则都写 var(--hero-image-m) 即可，
  // 不必在 CSS 里硬编码图片路径（brand.json 仍是配色的单一数据源）。
  const heroImgM = heroImgMobile ? `--hero-image-m:url('${heroImgMobile}');` : '';
  return `--brand:${b.primary};--brand-light:${b.primaryLight};--brand-dark:${b.primaryDark};--brand-bg:${b.primaryBg};--brand-border:${b.primaryBorder};--brand-glow:${glow};--bg:${b.bg};--bg-alt:${b.bgAlt};--card:${b.bg};--border:${b.border};--border-light:${b.border};--text:${b.text};--text-secondary:${b.textSecondary};--text-tertiary:${b.textTertiary};--fx-glow:${fx.heroGlow.color};--fx-grid:${grid};--fx-grid-opacity:${gridOp};--fx-particle:${fx.particles.color};--fx-card-glow:${cardGlow};--fx-card-border:${cardBorder};--hero-image:${heroImg};${heroImgM}--hero-ov-top:${ov.top};--hero-ov-mid:${ov.mid};--hero-ov-bottom:${ov.bottom};--hero-text:${heroText};--hero-text-secondary:${heroTextSec};--hero-accent:${heroAccent};--hero-eyebrow-bg:${heroEyebrowBg};--hero-overlay:${heroOverlay};--article-shield:${articleShield}`;
}

const lightTokens = buildTokens(lightCfg);
const darkTokens = darkCfg ? buildTokens(darkCfg) : '';
// 轮播命令(term-deco)在 hero 有背景图时强制白色（深色图上可读）——直接规则，绕过 CSS 变量层叠问题
const termRule = lightCfg.effects.heroImage ? '.hero .term-deco{color:#fff}' : '';
// 小屏换用轻量 hero 图（体积约减半）。写两条是因为 html.dark 特异性高于 :root，
// 光写 :root 压不住深色主题的 --hero-image。
// 注意：--hero-image-m 只在配置了 heroImageMobile 时才存在；未配置的主题（老主题/无图主题）
// 这两条规则里的 var() 会解析失败→该声明无效→回落到原有的 --hero-image，行为与改动前一致。
const mobileHeroRule = (lightCfg.effects.heroImageMobile || (darkCfg && darkCfg.effects.heroImageMobile))
  ? `@media(max-width:640px){:root{--hero-image:var(--hero-image-m)}${darkCfg ? ' html.dark{--hero-image:var(--hero-image-m)}' : ''}}`
  : '';
// 品牌 token 以字符串注入（is:global style 的 {expr} 插值不生效，用 is:inline + set:html）
const brandCss = `:root{${lightTokens}}${termRule}${darkTokens ? ` html.dark{${darkTokens}}` : ''}${mobileHeroRule}`;
// 注：曾经试过给 hero 图加 <link rel=preload>，实测在慢速移动网络下**帮倒忙**——
// 它在 HTML 还没下完时就抢带宽去下这张大图，把 CSS 挤后，load 一点没降、下载量反而多一张。
// 同环境对照（iPhone13 + 0.8Mbps/200ms RTT 各 3 次）：
//   改动前 load 5222ms / 下载 404KB  →  加 preload 后 5255ms / 404KB
//   去掉 preload、仅换轻量图          →  3721ms / 249KB
// 结论：只保留「小屏换轻量图」，不做 preload。
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="Linux 内核玩家" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
  <title>{title}</title>
  <script is:inline>
    (function(){var t=localStorage.getItem('kernel-blog-theme');if(t==='dark'||(t===null&&matchMedia('(prefers-color-scheme:dark)').matches))document.documentElement.classList.add('dark');})()
  </script>
  <style is:inline set:html={brandCss}></style>
</head>
<body>
  <div class="progress-bar"></div>
  <canvas id="particles-canvas"></canvas>

  <Nav />

  <slot />

  <Footer />

  <AnnouncementDrawer />

  <!-- 页面级浮层（如首页的新手入门面板）——独立于 fab-group，避免被收起动画影响 -->
  <slot name="overlays" />

  <!-- 右下角快捷操作组：默认收起，点主钮弹出。
       含全站通用的 回到顶部 / 意见反馈，以及各页面通过 fab-extra 追加的项。
       外层 fab-rail 与 .container 同宽同内边距，保证按钮与正文右边缘对齐（各断点一致） -->
  <div class="fab-rail">
    <div class="fab-group collapsed" id="fab-group">
      <div class="fab-group-items">
        <slot name="fab-extra" />
        <button class="to-top" id="to-top" aria-label="回到顶部" title="回到顶部">↑</button>
        <FeedbackFab />
      </div>
      <button class="fab-toggle" id="fab-toggle" aria-label="快捷操作" title="快捷操作" aria-expanded="false">⋯</button>
    </div>
  </div>

  <script>
    import '../scripts/main.js';
  </script>
</body>
</html>

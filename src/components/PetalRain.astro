---
// 花瓣飘落特效：Giscus 评论加载成功后触发（庆祝登录成功）
---
<canvas id="petal-rain" aria-hidden="true"></canvas>

<style>
  #petal-rain{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:700;opacity:0;transition:opacity .3s}
  #petal-rain.active{opacity:1}
</style>

<script>
  // 监听 Giscus 加载成功消息，触发花瓣
  window.addEventListener('message', function (e) {
    if (e.data && e.data.type === 'giscus:ready') startPetalRain();
  });

  function startPetalRain() {
    var canvas = document.getElementById('petal-rain');
    if (!canvas || canvas.dataset.running) return;
    canvas.dataset.running = '1';
    var ctx = canvas.getContext('2d');
    var W = canvas.width = innerWidth;
    var H = canvas.height = innerHeight;
    var colors = ['#F9A8D4', '#F472B6', '#FBCFE8', '#C4B5FD', '#E879F9', '#F0ABFC'];
    var petals = [];
    var COUNT = 60;

    for (var i = 0; i < COUNT; i++) {
      petals.push({
        x: Math.random() * W,
        y: -20 - Math.random() * H * 0.5,
        r: 6 + Math.random() * 7,
        speedY: 1.5 + Math.random() * 2.5,
        sway: 0.5 + Math.random() * 1.5,
        swaySpeed: 0.01 + Math.random() * 0.02,
        rot: Math.random() * Math.PI * 2,
        rotSpeed: (Math.random() - .5) * 0.06,
        color: colors[(Math.random() * colors.length) | 0],
        alpha: 0.8
      });
    }

    var start = Date.now();
    var DURATION = 7000; // 播放 7 秒
    canvas.classList.add('active');

    function frame() {
      var elapsed = Date.now() - start;
      ctx.clearRect(0, 0, W, H);

      petals.forEach(function (p) {
        p.y += p.speedY;
        p.x += Math.sin(p.swaySpeed * elapsed + p.rot) * p.sway;
        p.rot += p.rotSpeed;
        // 透明度随播放进度渐隐
        var fade = Math.min(1, (DURATION - elapsed) / 1500);
        if (fade <= 0) return;

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.globalAlpha = p.alpha * Math.max(0, fade);
        ctx.fillStyle = p.color;
        // 画一片花瓣（椭圆）
        ctx.beginPath();
        ctx.ellipse(0, 0, p.r, p.r * 0.6, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      });

      if (elapsed < DURATION) {
        requestAnimationFrame(frame);
      } else {
        canvas.classList.remove('active');
        ctx.clearRect(0, 0, W, H);
        delete canvas.dataset.running;
      }
    }
    frame();
  }
</script>

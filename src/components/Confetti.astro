---
// GitHub 风格彩色撒花：评论区加载成功/进入视口时触发（庆祝登录成功）
// 用 canvas-confetti 库复刻 GitHub merge-PR 的淡彩彩虹 + 两侧礼炮
---
<script>
  import confetti from 'canvas-confetti';

  // GitHub confetti 专属淡彩彩虹色板（过去粉色系，非饱和）
  const COLORS = ['#bfe5bf', '#ffcce0', '#ffdfbf', '#ffffbf', '#d4bfff', '#ffd4d4', '#d1f7c4', '#c7f0d8'];

  let fired = false;
  function celebrate() {
    if (fired) return;
    fired = true;

    // 中央大爆发：自下而上喷出一团彩虹
    confetti({
      particleCount: 140,
      spread: 110,
      startVelocity: 42,
      origin: { y: 0.65 },
      colors: COLORS,
      disableForReducedMotion: true,
    });

    // GitHub merge 签名：200ms 后两侧礼炮补射，对角冲起
    setTimeout(() => {
      confetti({
        particleCount: 65,
        angle: 60,
        spread: 55,
        startVelocity: 48,
        origin: { x: 0, y: 0.7 },
        colors: COLORS,
        disableForReducedMotion: true,
      });
      confetti({
        particleCount: 65,
        angle: 120,
        spread: 55,
        startVelocity: 48,
        origin: { x: 1, y: 0.7 },
        colors: COLORS,
        disableForReducedMotion: true,
      });
    }, 200);
  }

  // 双触发：① Giscus 加载成功消息 ② 评论区进入视口（用户来看评论）——只庆祝一次
  window.addEventListener('message', function (e) {
    if (e.data && e.data.type === 'giscus:ready') celebrate();
  });
  var comments = document.getElementById('comments');
  if (comments && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (en.isIntersecting) celebrate();
      });
    }, { threshold: 0.3 }).observe(comments);
  } else if (comments) {
    comments.addEventListener('click', function () { celebrate(); });
  }
</script>

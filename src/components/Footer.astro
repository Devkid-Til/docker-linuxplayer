---
// 页脚（组件化）
//
// ── 备案信息（合规必填，勿留空上线）────────────────────────────────────
// 依据：已备案网站须在「主页底部中央」标明备案编号，并将编号链接到工信部备案管理系统
//       （https://beian.miit.gov.cn/）供公众查询核对；未悬挂可被责令改正并处 5000~10000 元罚款。
//       公安备案通过后，须在 30 日内把编号（图标在前 16×17px、编号在右）挂到网页底部。
//
// ICP —— 工信部 ICP 备案号
//   ⚠️ 非广东地区挂【网站备案号】（带 -1 后缀）；广东地区挂主体备案号。别挂错。
//   何处获取：阿里云控制台 → ICP 备案 → 我的备案
//   格式示例：浙ICP备2026000000号-1
//   （本机 /srv 侧同理：工信部 beian.miit.gov.cn 用域名也可反查）
//
// GONGAN_HTML —— 公安备案编号 HTML 代码
//   何处获取：全国互联网安全管理服务平台 https://beian.mps.gov.cn
//             → 已备案网站详情 → 复制备案编号 HTML 代码 + 下载图标。勿手写。
//   格式示例：<a href="https://beian.mps.gov.cn/#/query/webSearch?code=33010002000000"
//              target="_blank" rel="noopener"><img src="/gongan.png"
//              style="width:16px;height:17px;vertical-align:-3px"> 浙公网安备33010002000000号</a>
//
// 网站名称须与备案信息一致 —— 首页 <title> 现为「Linux 内核玩家 · 每日内核雷达」，勿随意改名。
// ⚠️ 待确认：以下为**主体备案号**。按悬挂规范，非广东地区页脚应挂【网站备案号】
//    （主体号 + 网站顺序后缀，形如「京ICP备2026052207号-1」；广东地区才挂主体号）。
//    请到阿里云「ICP 备案 → 我的备案 → 网站详情」核对网站备案号的准确写法；
//    若确实是带 -1 的，把下面这行改掉即可。
const ICP = "京ICP备2026052207号";
const GONGAN_HTML = "";

// 构建期提醒：ICP 已通过却未悬挂 = 违规状态。别静默上线。
// 用 globalThis 打标——astro build 会逐页渲染，否则 52 个页面各报一次刷爆日志。
if (!ICP && !(globalThis as any).__beianWarned) {
  (globalThis as any).__beianWarned = true;
  console.warn(
    '[footer] ⚠ ICP 备案号为空：已备案网站必须在主页底部标明备案编号并链接工信部，' +
    '未悬挂可被责令改正并处 5000~10000 元罚款。请填 src/components/Footer.astro 的 ICP 常量。'
  );
}
---
<footer class="site-footer">
  <div class="container">
    <div class="brand-line">内核是主业，玩家是态度</div>
    <p class="source">数据来源 lore.kernel.org · 北京时间</p>
    <div class="links"><a href="/">首页</a><a href="/subscribe/">RSS</a></div>
    {(ICP || GONGAN_HTML) && (
      <div class="beian">
        {ICP && <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">{ICP}</a>}
        {GONGAN_HTML && <span set:html={GONGAN_HTML} />}
      </div>
    )}
    <p class="copyright">© {new Date().getFullYear()} Linux 内核玩家</p>
  </div>
</footer>

---
// 导读/机制/速查：卡片内 chips 标签 + 说明
import type { TocBlock } from './types';
interface Props { block: TocBlock; }
const { block } = Astro.props;
---
<section class="block-card block-toc">
  {block.items.map(item => (
    <div class="toc-item">
      <span class="toc-chip">{item.label}</span>
      <span class="toc-text" set:html={item.text} />
    </div>
  ))}
</section>

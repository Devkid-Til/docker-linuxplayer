---
// 亮点卡：★ 标题 + 压缩弧线徽章 + 和你相关 + 原文
import type { HighlightBlock } from './types';
interface Props { block: HighlightBlock; }
const { block } = Astro.props;
---
<section class="block-card block-highlight">
  <div class="headline-head">
    <h3><span class="hi-star">★</span> {block.title}</h3>
    {block.meta && <p class="meta">{block.meta}</p>}
  </div>
  <div class="headline-points">
    {block.points.map(p => (
      <div class="b-point">
        <span class="b-label">{p.label}</span>
        <span class="b-text" set:html={p.text} />
      </div>
    ))}
  </div>
  {block.relevance && (
    <div class="b-point b-relevance">
      <span class="b-label">和你相关</span>
      <span class="b-text" set:html={block.relevance} />
    </div>
  )}
  {block.link && (
    <p class="b-link">🔗 <a href={block.link}>原文</a></p>
  )}
</section>

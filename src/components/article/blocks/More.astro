---
// 常规动态：○ 灰色条目（可带时间/链接）
import type { MoreBlock } from './types';
interface Props { block: MoreBlock; }
const { block } = Astro.props;
---
<section class="block-more">
  <p class="m-title">{block.title ?? '更多动态'}</p>
  {block.items.map(item => (
    <p class="m-item">
      <span class="b-bullet">○</span>
      {item.link
        ? <a href={item.link} set:html={item.text} />
        : <span set:html={item.text} />}
      {item.time && <span class="m-time">〔{item.time}〕</span>}
    </p>
  ))}
</section>

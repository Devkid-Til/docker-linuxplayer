---
// 头条卡：顶部 2px 主色横线 + 居中标题/出处 + 标签要点 + 一句话点评 + 原文
import type { HeadlineBlock } from './types';
interface Props { block: HeadlineBlock; }
const { block } = Astro.props;
---
<section class="block-headline">
  <p class="h-title">{block.title}</p>
  <p class="h-meta">{block.meta}</p>
  {block.points.map(p => (
    <p class="b-point"><span class="b-bullet">•</span> <span class="b-label">{p.label}</span>：<span set:html={p.text} /></p>
  ))}
  {block.verdict && (
    <p class="h-verdict"><span class="b-label">一句话点评</span>：<span set:html={block.verdict} /></p>
  )}
  {block.link && (
    <p class="h-link">🔗 <a href={block.link}>原文</a></p>
  )}
</section>

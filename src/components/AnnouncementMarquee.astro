---
import announcements from '../data/announcements.json';
const active = announcements.filter(a => a.active).sort((a, b) => b.date.localeCompare(a.date));
const latest = active[0] || null;
---
{latest && (
  <div class="ann-marquee">
    <button class="ann-marquee-btn" data-drawer-open="announcements" aria-label="查看最新公告" title="查看最新公告">
      <span class="ann-marquee-viewport">
        <span class="ann-marquee-track">
          <span class="ann-marquee-text">{latest.title}</span>
        </span>
      </span>
    </button>
  </div>
)}

<script is:inline>
  (function () {
    var viewport = document.querySelector('.ann-marquee-viewport');
    var track = document.querySelector('.ann-marquee-track');
    var text = document.querySelector('.ann-marquee-text');
    if (!viewport || !track || !text) return;

    // 复制足够份数，保证无缝循环（视口宽度 / 单份宽度 + 2）
    var w = viewport.clientWidth;
    var c = text.offsetWidth;
    if (w <= 0 || c <= 0) return;
    var n = Math.ceil(w / c) + 2;
    while (track.children.length < n) {
      track.appendChild(text.cloneNode(true));
    }

    // rAF 驱动跑马灯：滚动一份宽度后回绕，无缝
    var x = 0;
    var speed = 0.6; // px/frame ≈ 36px/s
    function step() {
      x += speed;
      if (x >= c) x -= c;
      track.style.transform = 'translateX(' + (-x) + 'px)';
      requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  })();
</script>

<style>
  .ann-marquee { display: none; }

  @media (max-width: 640px) {
    .ann-marquee {
      display: block;
      position: absolute; top: 0; left: 0; right: 0;
      z-index: 1;
      background: transparent;
      overflow: hidden;
      padding: 6px 0;
    }
    .ann-marquee-btn {
      display: flex; align-items: center; width: 100%;
      background: none; border: none; cursor: pointer; padding: 0;
    }
    .ann-marquee-viewport {
      flex: 1; overflow: hidden; white-space: nowrap;
    }
    .ann-marquee-track {
      display: inline-flex; white-space: nowrap; will-change: transform;
    }
    .ann-marquee-text {
      display: inline-block; padding-right: 3rem;
      font-size: .75rem; line-height: 1.6;
      color: var(--hero-text, rgba(255,255,255,.9));
    }
  }
</style>

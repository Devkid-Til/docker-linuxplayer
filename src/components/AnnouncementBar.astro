---
import announcements from '../data/announcements.json';
interface Props {
  variant?: 'desktop' | 'mobile';
}
const { variant = 'desktop' } = Astro.props;
const suffix = variant === 'mobile' ? '-mobile' : '-desktop';
const active = announcements.filter(a => a.active).sort((a, b) => b.date.localeCompare(a.date));
const latest = active[0] || null;
const latestId = latest ? latest.id : '';
const latestTitle = latest ? latest.title : '';
const latestDate = latest ? latest.date : '';
---
<div class={`ann-bar ann-bar-${variant}`} id={`ann-bar${suffix}`}>
  <button class="ann-bell" id={`ann-bell${suffix}`} data-drawer-open="announcements" aria-label="公告" title="公告">
    📢
    <span class="ann-dot" id={`ann-dot${suffix}`}></span>
  </button>
  {variant === 'desktop' && latest && (
    <button class="ann-ticker" id={`ann-ticker${suffix}`} data-drawer-open="announcements" aria-label="查看最新公告" title="查看最新公告">
      <span class="ann-ticker-track">
        <span class="ann-ticker-text" data-latest-id={latestId} data-latest-date={latestDate}>{latestTitle}</span>
      </span>
    </button>
  )}
  {variant === 'mobile' && latest && (
    <button class="ann-ticker-mobile" id={`ann-ticker${suffix}`} data-drawer-open="announcements" aria-label="查看最新公告" title="查看最新公告">
      <span class="ann-mobile-viewport">
        <span class="ann-mobile-track">
          <span class="ann-ticker-text" data-latest-id={latestId} data-latest-date={latestDate}>{latestTitle}</span>
        </span>
      </span>
    </button>
  )}
</div>

<script is:inline>
  (function () {
    var KEY = 'kernel-blog-ann-read';
    var latestEl = document.querySelector('.ann-ticker-text');
    var latestId = latestEl ? latestEl.getAttribute('data-latest-id') : '';
    var latestDate = latestEl ? latestEl.getAttribute('data-latest-date') : '';

    function isUnread() {
      try {
        var last = localStorage.getItem(KEY);
        if (!last) return true;
        var parsed;
        try { parsed = JSON.parse(last); } catch (e) { parsed = { date: last }; }
        if (parsed.id === latestId) return false;
        return !parsed.date || parsed.date < latestDate;
      } catch (e) { return true; }
    }

    document.querySelectorAll('.ann-dot').forEach(function (dot) {
      if (isUnread()) dot.classList.add('unread');
    });

    function openAndMark(e) {
      if (e) e.stopPropagation();
      if (window.drawers) window.drawers.open('announcements');
      document.querySelectorAll('.ann-dot').forEach(function (dot) { dot.classList.remove('unread'); });
      try { localStorage.setItem(KEY, JSON.stringify({ id: latestId, date: latestDate })); } catch (e) {}
    }

    document.querySelectorAll('.ann-bell, .ann-ticker, .ann-ticker-mobile').forEach(function (btn) {
      btn.addEventListener('click', openAndMark);
    });

    // 移动端 header 内跑马灯：标题溢出才滚动，否则居中静态
    var viewport = document.querySelector('.ann-mobile-viewport');
    var track = document.querySelector('.ann-mobile-track');
    var text = track ? track.querySelector('.ann-ticker-text') : null;
    if (viewport && track && text) {
      var w = viewport.clientWidth;
      var c = text.offsetWidth;
      if (w > 0 && c > 0) {
        if (c <= w) {
          // 不溢出：居中静态
          track.classList.add('ann-mobile-static');
        } else {
          // 溢出：复制足够份数 + rAF 滚动
          var n = Math.ceil(w / c) + 2;
          while (track.children.length < n) track.appendChild(text.cloneNode(true));
          var x = 0, speed = 0.6;
          function step() {
            x += speed;
            if (x >= c) x -= c;
            track.style.transform = 'translateX(' + (-x) + 'px)';
            requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        }
      }
    }
  })();
</script>

<style>
  .ann-bar { display: flex; align-items: center; gap: 6px; }
  .ann-bar-mobile { display: none; }
  .ann-bell {
    position: relative; width: 36px; height: 36px; border-radius: 50%;
    background: none; border: 1px solid var(--border); cursor: pointer;
    display: flex; align-items: center; justify-content: center; font-size: 1rem;
    color: var(--text-secondary); transition: border-color .15s, background .15s;
    flex-shrink: 0;
  }
  .ann-bell:hover { border-color: var(--brand); background: var(--brand-bg); }
  .ann-dot {
    position: absolute; top: 6px; right: 6px; width: 8px; height: 8px;
    background: #EF4444; border-radius: 50%; opacity: 0; transition: opacity .15s;
  }
  .ann-dot.unread { opacity: 1; }
  .ann-ticker {
    max-width: 160px; overflow: hidden; background: none; border: none;
    padding: 0; cursor: pointer; text-align: left;
  }
  .ann-ticker-track {
    display: block; position: relative; overflow: hidden; white-space: nowrap;
  }
  .ann-ticker-text {
    display: inline-block; font-size: .8125rem; color: var(--text-secondary);
    padding-right: 1rem; line-height: 1.4;
  }
  @media (hover: hover) {
    .ann-ticker-text:hover { color: var(--brand); }
  }

  @media (max-width: 640px) {
    .ann-bar-desktop { display: none; }
    .ann-bar-mobile { display: flex; flex: 1; min-width: 0; }
    .ann-ticker { display: none; }
    .ann-ticker-mobile {
      flex: 1; min-width: 0; overflow: hidden; background: none; border: none;
      padding: 0; cursor: pointer; text-align: left;
    }
    .ann-mobile-viewport {
      display: block; overflow: hidden; white-space: nowrap; width: 100%;
    }
    .ann-mobile-track {
      display: inline-flex; white-space: nowrap; align-items: center;
    }
    .ann-mobile-static { width: 100%; justify-content: center; }
    .ann-ticker-text {
      font-size: .75rem; color: var(--text-secondary);
      padding-right: 2rem; line-height: 1.4;
    }
  }
</style>

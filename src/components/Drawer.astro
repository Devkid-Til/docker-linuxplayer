---
// 通用右侧滑出抽屉
// 用法：
// <Drawer id="my-drawer" title="标题">
//   <p>内容</p>
// </Drawer>
// 然后 JS 里调用 window.drawers.open('my-drawer') / close('my-drawer')
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---
<div class="drawer-backdrop" id={`drawer-backdrop-${id}`} data-drawer={id} aria-hidden="true"></div>
<aside class="drawer-panel" id={`drawer-panel-${id}`} data-drawer={id} aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby={`drawer-title-${id}`}>
  <!-- 左侧手势条：和内容层隔离，专门负责右滑关闭 -->
  <div class="drawer-edge" aria-hidden="true"></div>
  <div class="drawer-content">
    <div class="drawer-header">
      <h3 id={`drawer-title-${id}`}>{title}</h3>
      <button class="drawer-close" data-drawer-close={id} aria-label="关闭">✕</button>
    </div>
    <div class="drawer-body">
      <slot />
    </div>
  </div>
</aside>

<script is:inline>
  (function () {
    if (window.drawers) return;
    window.drawers = {
      open: function (id) {
        var backdrop = document.getElementById('drawer-backdrop-' + id);
        var panel = document.getElementById('drawer-panel-' + id);
        if (!backdrop || !panel) return;
        backdrop.classList.add('open');
        panel.classList.add('open');
        backdrop.setAttribute('aria-hidden', 'false');
        panel.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      },
      close: function (id) {
        var backdrop = document.getElementById('drawer-backdrop-' + id);
        var panel = document.getElementById('drawer-panel-' + id);
        if (!backdrop || !panel) return;
        backdrop.classList.remove('open');
        panel.classList.remove('open');
        backdrop.setAttribute('aria-hidden', 'true');
        panel.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    };

    document.addEventListener('click', function (e) {
      var target = e.target;
      var openEl = target && target.closest && target.closest('[data-drawer-open]');
      var openId = openEl ? openEl.getAttribute('data-drawer-open') : null;
      if (openId) {
        e.preventDefault();
        window.drawers.open(openId);
      }
      var closeEl = target && target.closest && target.closest('[data-drawer-close]');
      var closeId = closeEl ? closeEl.getAttribute('data-drawer-close') : null;
      if (closeId) {
        e.preventDefault();
        window.drawers.close(closeId);
      }
      if (target && target.classList && target.classList.contains('drawer-backdrop') && target.classList.contains('open')) {
        var id = target.getAttribute('data-drawer');
        if (id) window.drawers.close(id);
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        var openPanel = document.querySelector('.drawer-panel.open');
        if (openPanel) {
          var id = openPanel.getAttribute('data-drawer');
          if (id) window.drawers.close(id);
        }
      }
    });

    // 抽屉内链接跳转到同页 hash（如 /#english）时不会刷新页面，需要自动关抽屉
    function closeAllDrawers() {
      document.querySelectorAll('.drawer-panel.open').forEach(function (panel) {
        var id = panel.getAttribute('data-drawer');
        if (id) window.drawers.close(id);
      });
    }
    window.addEventListener('hashchange', closeAllDrawers);

    // 抽屉右滑关闭：手势条与内容层隔离，从根本上避免内容（链接/滚动）截胡事件
    (function initSwipe() {
      var DRAG_START_THRESHOLD = 4; // px：向右滑动超过此值启动拖动
      var CLOSE_RATIO = 0.25;       // 滑动超过面板宽度 25% 关闭
      var CLOSE_MIN_PX = 56;        // 至少滑动 56px

      function bindSwipe(panel) {
        var edge = panel.querySelector('.drawer-edge');
        if (!edge) return;

        var dragging = false;
        var startX = 0, currentX = 0;

        function resetTransform() {
          panel.style.transform = '';
          panel.style.transition = '';
        }

        function finish(dx) {
          dragging = false;
          panel.style.transition = 'transform .2s var(--ease-out)';
          var threshold = Math.max(CLOSE_MIN_PX, panel.offsetWidth * CLOSE_RATIO);
          if (dx > threshold) {
            panel.style.transform = 'translateX(100%)';
            setTimeout(function () {
              var id = panel.getAttribute('data-drawer');
              if (id) window.drawers.close(id);
              resetTransform();
            }, 200);
          } else {
            panel.style.transform = 'translateX(0)';
            setTimeout(resetTransform, 200);
          }
        }

        function onStart(clientX) {
          if (!panel.classList.contains('open')) return false;
          startX = clientX;
          currentX = clientX;
          dragging = false;
          panel.style.transition = 'none';
          return true;
        }

        function onMove(clientX) {
          var dx = clientX - startX;
          currentX = clientX;
          if (!dragging) {
            if (dx > DRAG_START_THRESHOLD) dragging = true; else return false;
          }
          panel.style.transform = 'translateX(' + Math.max(0, dx) + 'px)';
          return true;
        }

        function onEnd() {
          if (!dragging) return;
          finish(currentX - startX);
        }

        function onCancel() {
          if (!dragging) return;
          dragging = false;
          resetTransform();
        }

        // Touch 主路径
        edge.addEventListener('touchstart', function (e) {
          if (onStart(e.touches[0].clientX)) return;
        }, { passive: true });

        edge.addEventListener('touchmove', function (e) {
          if (onMove(e.touches[0].clientX)) e.preventDefault();
        }, { passive: false });

        edge.addEventListener('touchend', onEnd);
        edge.addEventListener('touchcancel', onCancel);

        // Pointer 兜底（桌面鼠标 / 触屏笔记本）
        var pointerActive = false;
        edge.addEventListener('pointerdown', function (e) {
          if (!onStart(e.clientX)) return;
          pointerActive = true;
          try { edge.setPointerCapture(e.pointerId); } catch (err) {}
        });

        edge.addEventListener('pointermove', function (e) {
          if (!pointerActive) return;
          if (onMove(e.clientX)) e.preventDefault();
        });

        edge.addEventListener('pointerup', function () {
          if (!pointerActive) return;
          pointerActive = false;
          onEnd();
        });

        edge.addEventListener('pointercancel', function () {
          pointerActive = false;
          onCancel();
        });
      }

      document.querySelectorAll('.drawer-panel').forEach(bindSwipe);
    })();
  })();
</script>

<style>
  .drawer-backdrop {
    position: fixed; inset: 0; background: rgba(0,0,0,.45);
    opacity: 0; pointer-events: none; transition: opacity .25s var(--ease-out);
    z-index: 950;
  }
  .drawer-backdrop.open { opacity: 1; pointer-events: auto; }
  .drawer-panel {
    position: fixed; top: 0; right: 0; bottom: 0; width: min(420px, 90vw);
    background: var(--card); border-left: 1px solid var(--border);
    box-shadow: var(--shadow-lg); transform: translateX(100%);
    transition: transform .3s var(--ease-out); z-index: 960;
    display: flex; flex-direction: row; /* 水平排列：手势条 + 内容 */
  }
  .drawer-panel.open { transform: translateX(0); }

  /* 左侧手势条：与内容完全隔离 */
  .drawer-edge {
    width: 28px; flex-shrink: 0; height: 100%;
    cursor: ew-resize; /* 提示可拖动 */
    touch-action: pan-y;
    position: relative;
  }
  /* 可视指示：一条小灰线，让用户知道这里可以拖 */
  .drawer-edge::after {
    content: ''; position: absolute; top: 50%; left: 50%;
    width: 4px; height: 36px; transform: translate(-50%, -50%);
    background: var(--border); border-radius: 2px;
  }

  .drawer-content {
    flex: 1; display: flex; flex-direction: column;
    min-width: 0; /* 防止 flex 子项撑开 */
  }
  .drawer-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--space-md) var(--space-lg); border-bottom: 1px solid var(--border);
  }
  .drawer-header h3 { margin: 0; font-size: 1rem; color: var(--text); }
  .drawer-close {
    background: none; border: none; font-size: 1.25rem; color: var(--text-secondary);
    cursor: pointer; padding: 4px; line-height: 1; border-radius: var(--radius-sm);
  }
  .drawer-close:hover { color: var(--text); background: var(--brand-bg); }
  .drawer-body { flex: 1; overflow-y: auto; padding: var(--space-lg); }

  @media (max-width: 640px) {
    .drawer-panel { width: 92vw; }
    .drawer-edge { width: 24px; }
  }
</style>

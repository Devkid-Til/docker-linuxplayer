---
// 文章页意见反馈按钮：位于右下角快捷操作组内，点击跳飞书表单并预填当前页链接。
// 预填参数格式（飞书官方）：表单分享链接 + ?prefill_问题名称=值，问题名称须与表单题目完全一致。
const FORM_URL = 'https://uq0ip8uep08.feishu.cn/share/base/shrcnSIfR7Sd2oEvR2E0HJHL38g';
---
<button class="fab-feedback" id="fab-feedback" aria-label="意见反馈" title="意见反馈">💬</button>

<script define:vars={{ FORM_URL }}>
  (function () {
    var fab = document.getElementById('fab-feedback');
    if (!fab) return;
    // 旧版本会把拖动位置存进 localStorage，导致刷新后停在视口外——进页面即清理
    try { localStorage.removeItem('fab-feedback-pos'); } catch (e) {}

    fab.addEventListener('click', function () {
      // 来源页面 = 当前页 URL（不含 hash）
      var url = location.origin + location.pathname;
      window.open(FORM_URL + '?prefill_' + encodeURIComponent('来源页面') + '=' + encodeURIComponent(url), '_blank', 'noopener');
    });
  })();
</script>

<style>
  /* 尺寸/定位由 global.css 的 .fab-group 统一控制，这里只定外观 */
  .fab-feedback {
    position: static;
    background: var(--brand);
    border: none;
    color: #fff;
    font-size: 1.25rem;
    box-shadow: 0 4px 14px var(--brand-glow);
    transition: transform .15s, box-shadow .15s;
  }
  .fab-feedback:hover { transform: scale(1.08); box-shadow: 0 6px 20px var(--brand-glow); }
</style>

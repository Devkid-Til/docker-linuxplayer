---
// 文章卡片组件（首页/标签页共用）；latest=true 时标记「今日」（不限栏目，latest 由 index 页按最新一篇计算）
// focus（english 栏目主维度）显示「🎯 今日重点」徽标——每篇英语文章有明确学习侧重
import { COLUMN_MAP } from '../column';

interface Props {
  latest?: boolean;
  column?: string;
  slug: string;
  date: string;
  title: string;
  desc: string;
  tags: string[];
  focus?: string;
}
const FOCUS_EMOJI: Record<string, string> = {
  '标题解析': '🔖', '术语卡': '🃏', '地道表达': '💬', '阅读': '📖', '写作': '✍️', '口语': '🎤',
};
const { latest = false, column = 'daily', slug, date, title, desc, tags, focus } = Astro.props;
const displayDate = date.slice(5); // MM-DD
const colMeta = COLUMN_MAP[column] || COLUMN_MAP.daily;
---
<div class="timeline-item reveal" data-tags={tags.join(',')} data-column={column}>
  <a class="timeline-card" href={`/posts/${slug}/`}>
    <div class="timeline-meta">
      <span class="timeline-date">{displayDate}</span>
      <span class="timeline-cat">{colMeta.emoji} {colMeta.label}</span>
      {focus && <span class="focus-badge">🎯 今日重点：{FOCUS_EMOJI[focus] || ''} {focus}</span>}
      {latest && <span class="timeline-latest">今日</span>}
    </div>
    <h3>{title}</h3>
    <p class="timeline-excerpt">{desc}</p>
    <div class="timeline-tags">{tags.map(t => <span class="tag">{t}</span>)}</div>
  </a>
</div>

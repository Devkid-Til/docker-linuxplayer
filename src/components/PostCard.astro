---
// 文章卡片组件（首页/标签页共用）
interface Props {
  slug: string;
  date: string;
  title: string;
  desc: string;
  tags: string[];
}
const { slug, date, title, desc, tags } = Astro.props;
const displayDate = date.slice(5); // MM-DD
---
<div class="timeline-item reveal" data-tags={tags.join(',')}>
  <a class="timeline-card" href={`/posts/${slug}/`}>
    <div class="timeline-meta"><span class="timeline-date">{displayDate}</span><span class="timeline-cat">每日内核日报</span></div>
    <h3>{title}</h3>
    <p class="timeline-excerpt">{desc}</p>
    <div class="timeline-tags">{tags.map(t => <span class="tag">{t}</span>)}</div>
  </a>
</div>

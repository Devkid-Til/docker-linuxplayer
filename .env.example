# 环境变量模板 —— 复制为 .env 并填入真实值（.env 不入库）
# 新机器接入：cp .env.example .env → 填以下变量

# ── Giscus 评论（GitHub Discussions）──
PUBLIC_GISCUS_REPO=用户名/评论仓库名
PUBLIC_GISCUS_REPO_ID=R_xxx
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=DIC_xxx

# ── 阿里云 OSS（封面/插图上传）──
# RAM 用户 AccessKey（勿用主账号）；RAM 控制台创建子用户后生成
# 注意：OSS 键不带 PUBLIC_ 前缀（纯 Node 脚本用），勿改成 PUBLIC_OSS_*——那是 Astro 客户端暴露命名空间
OSS_AK_ID=LTAIxxxxxxxxxxxxxxxx
OSS_AK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
OSS_BUCKET=kernelplayer
OSS_REGION=oss-cn-beijing

# （公众号审阅通知：走 cc-connect 发截图/文件，无需额外配置）
